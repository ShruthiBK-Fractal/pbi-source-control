                "Literal": {
                  "Value": "'{\r\n  \"data\": { \"name\": \"dataset\" },\r\n  \"transform\": [\r\n    { \"filter\": \"datum.agent_name != null\" },\r\n    {\r\n      \"calculate\": \"datum[''APE_YTD''] / datum[''Target_YTD'']\",\r\n      \"as\": \"attainment\"\r\n    },\r\n    {\r\n      \"calculate\": \"datum.attainment >= 1.1 ? ''Above target'' : datum.attainment >= 0.9 ? ''On track'' : ''Below target''\",\r\n      \"as\": \"status\"\r\n    }\r\n  ],\r\n  \"layer\": [\r\n    {\r\n      \"mark\": \"bar\",\r\n      \"encoding\": {\r\n        \"y\": { \"field\": \"agent_name\", \"type\": \"nominal\", \"title\": \"Agent\" },\r\n        \"x\": { \"field\": \"APE_YTD\", \"type\": \"quantitative\", \"title\": \"APE (USD)\" },\r\n        \"color\": {\r\n          \"field\": \"status\",\r\n          \"type\": \"nominal\",\r\n          \"scale\": {\r\n            \"domain\": [\"Above target\", \"On track\", \"Below target\"],\r\n            \"range\": [\"#1D9E75\", \"#378ADD\", \"#E24B4A\"]\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"mark\": { \"type\": \"tick\", \"color\": \"black\", \"thickness\": 10, \"size\": 50 },\r\n      \"encoding\": {\r\n        \"y\": { \"field\": \"agent_name\", \"type\": \"nominal\" },\r\n        \"x\": { \"field\": \"Target_YTD\", \"type\": \"quantitative\" },\r\n                \"tooltip\": [\r\n          { \"field\": \"agent_name\", \"type\": \"nominal\", \"title\": \"Agent\" },\r\n          { \"field\": \"ape_actual\", \"type\": \"quantitative\", \"title\": \"APE\" },\r\n          { \"field\": \"ape_target\", \"type\": \"quantitative\", \"title\": \"Target\" },\r\n          { \"field\": \"ratio\", \"type\": \"quantitative\", \"title\": \"APE / Target\" }\r\n        ]\r\n\r\n      }\r\n    }\r\n  ]\r\n}'"
