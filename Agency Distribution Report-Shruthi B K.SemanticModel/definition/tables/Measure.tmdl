	measure 'Top Product by APE' =
			
			VAR __TopTable =
			    TOPN (
			        1,
			        ALLSELECTED ( dim_product[product_name] ),
			        [APE_YTD],
			        DESC
			    )
			RETURN
			MAXX ( __TopTable, dim_product[product_name] )
		lineageTag: 5f36db09-5ac3-44a4-b049-2815cb21f1f1

	measure 'APE MoM Growth %' = ```
			
			VAR CurrentAPE = [FCT_APE]
			VAR PreviousMonthAPE =
			    CALCULATE ( [FCT_APE], DATEADD ( dim_date[Date], -1, MONTH ) )
			RETURN 
			    DIVIDE ( CurrentAPE - PreviousMonthAPE, PreviousMonthAPE )
			```
		lineageTag: 3e261d2f-1699-4e04-a5aa-f81e021d397d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Persistency_Rate% = DIVIDE(CALCULATE(DISTINCTCOUNT(fact_persistency[policy_id]),fact_persistency[renewal_status]="renewed"),DISTINCTCOUNT(fact_persistency[policy_id]),0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3b375dd9-8146-4717-9996-510ad7f41589

	measure 'Active Policy Count' =
			
			VAR TempDate = MAX ( dim_date[Date] )
			VAR TempKey = VALUE ( FORMAT ( Tempdate, "YYYYMMDD" ) )
			RETURN
			CALCULATE (
			    COUNTROWS ( fact_persistency ),
			    fact_persistency[issue_date_key] <= TempKey,
			    fact_persistency[renewal_due_date_key] > TempDate
			)
		formatString: 0
		lineageTag: da9b41ea-a3c5-4097-9ed6-4ab8bf4e4d8a

	measure Renewed_Count = CALCULATE(COUNTROWS(fact_persistency),fact_persistency[renewal_status]="renewed")
		formatString: 0
		lineageTag: dd908928-8b44-4ff1-b622-c0fcd5d7cdc8

