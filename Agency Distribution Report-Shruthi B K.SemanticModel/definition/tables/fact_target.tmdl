	partition fact_target = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\Shruthi.K\OneDrive - Fractal Analytics Limited\Documents\Chubb Assignment\data\fact_target.csv"), [Delimiter = ",", Columns = 4, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"agent_id", Int64.Type}, {"year", Int64.Type}, {"month", Int64.Type}, {"ape_target_usd", type number}}),
				  #"Duplicated column" = Table.TransformColumnTypes(Table.AddColumn(#"Changed column type", "YearMonth", each [year] * 100 + [month]), {{"YearMonth", Int64.Type}})
				in
				  #"Duplicated column"

	annotation PBI_ResultType = Table

